<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OpenRouter 无监管 AI</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #e2e8f0; margin: 0; display: flex; flex-direction: column; height: 100vh; }
    .header { padding: 15px 20px; background: #1e293b; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; }
    .header h1 { margin: 0; font-size: 18px; color: #6366f1; }
    .chat-box { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 15px; }
    .message { max-width: 80%; padding: 12px 16px; border-radius: 12px; font-size: 15px; line-height: 1.5; word-break: break-word; }
    .user { align-self: flex-end; background: #4f46e5; color: white; border-bottom-right-radius: 2px; }
    .ai { align-self: flex-start; background: #334155; color: #f8fafc; border-bottom-left-radius: 2px; }
    .input-box { padding: 15px; background: #1e293b; border-top: 1px solid #334155; display: flex; gap: 10px; }
    input { flex: 1; padding: 12px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: white; font-size: 15px; outline: none; }
    button { padding: 12px 20px; border-radius: 8px; border: none; background: #6366f1; color: white; font-weight: bold; cursor: pointer; }
    button:hover { background: #4f46e5; }
  </style>
</head>
<body>

  <div class="header">
    <h1>🌐 OpenRouter 无监管 AI</h1>
    <button onclick="setApiKey()" style="padding: 6px 12px; font-size: 12px;">设置 OpenRouter Key</button>
  </div>

  <div class="chat-box" id="chat-box">
    <div class="message ai">你好！请先点击右上角设置你的 OpenRouter API Key (sk-or-v1-...) 即可开始无限制对话。</div>
  </div>

  <div class="input-box">
    <input type="text" id="user-input" placeholder="输入任意问题..." onkeydown="if(event.key==='Enter') sendMessage()">
    <button onclick="sendMessage()">发送</button>
  </div>

  <script>
    let apiKey = localStorage.getItem('openrouter_api_key') || '';

    function setApiKey() {
      const key = prompt('请输入你的 OpenRouter API Key (sk-or-v1-...):', apiKey);
      if (key) {
        apiKey = key.trim();
        localStorage.setItem('openrouter_api_key', apiKey);
        alert('Key 已保存在本地！');
      }
    }

    async function sendMessage() {
      const input = document.getElementById('user-input');
      const text = input.value.trim();
      if (!text) return;

      if (!apiKey) {
        alert('请先设置 API Key！');
        setApiKey();
        return;
      }

      appendMessage(text, 'user');
      input.value = '';

      const aiMsgDiv = appendMessage('AI 正在思考中...', 'ai');

      try {
        const response = await fetch('https://openrouter.ai/api/v1/chat/completions', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${apiKey}`,
            'Content-Type': 'application/json',
            'HTTP-Referer': window.location.href,
            'X-Title': 'My AI App'
          },
          body: JSON.stringify({
            // 使用开源无限制/极低审查模型（可根据需要更换）
            model: 'gryphe/mythomax-l2-13b:free', 
            messages: [{ role: 'user', content: text }]
          })
        });

        const data = await response.json();
        if (data.choices && data.choices[0]) {
          aiMsgDiv.innerText = data.choices[0].message.content;
        } else {
          aiMsgDiv.innerText = '错误：' + (data.error?.message || '请求失败，请检查 Key 或余额/额度');
        }
      } catch (e) {
        aiMsgDiv.innerText = '网络连接失败，请检查 API Key。';
      }
    }

    function appendMessage(text, role) {
      const chatBox = document.getElementById('chat-box');
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${role}`;
      msgDiv.innerText = text;
      chatBox.appendChild(msgDiv);
      chatBox.scrollTop = chatBox.scrollHeight;
      return msgDiv;
    }
  </script>
</body>
</html>
